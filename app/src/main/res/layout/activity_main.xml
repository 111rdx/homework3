<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/main_title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnExp1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/exp1"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnExp2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/exp2"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnExp3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/exp3"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnExp4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/exp4"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnExp5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/exp5" />

</LinearLayout>
